# ==============================================================================
# VARIABLES DE ENTORNO REQUERIDAS - LUMÉ E-COMMERCE (ESQUEMA HÍBRIDO)
# ==============================================================================

# Puerto de escucha del servidor (Render asigna automáticamente el PORT)
PORT=8080

# 1. BASE DE DATOS PRINCIPAL: AIVEN.IO (PostgreSQL Administrado)
# Connection URI completo obtenido en la consola de Aiven.io (Overview > Service URI)
# Formato: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
AIVEN_DATABASE_URL=postgres://avnadmin:tu_password_aiven@pg-tu-servicio.aivencloud.com:12345/defaultdb?sslmode=require

# 2. AUTENTICACIÓN: SUPABASE AUTH (Verificación de sesiones y JWT)
# Obtén estos valores en tu panel de Supabase: Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_clave_anon_publica

# Variables públicas para Next.js en el cliente
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_clave_anon_publica
NEXT_PUBLIC_WHATSAPP_PHONE=5491122334455
NEXT_PUBLIC_STORE_NAME=Lumé Home & Scents
